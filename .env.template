# Copy to .env before running `docker compose up` on the machine hosting the game.

# Hostname or LAN IP the players type into their browser. This is baked into the
# frontend at container start, so "localhost" only works if the only player is you.
PUBLIC_HOST=192.168.0.10

# Guards /game/mode, which starts and ends the game and reveals everyone's solutions.
LEADERBOARD_API_KEY=change-me
