# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production'
PORT="8080"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# Postgres
PG_USER="admin"
PG_PASSWORD="password"
PG_HOST="postgres" # localhost
PG_PORT="5432" # 5175

# Read only role that runs the players' SQL, see sql-data/postgres-roles.sql
PG_PLAYER_USER="player"
PG_PLAYER_PASSWORD="player"

# SQL Server
SQL_SERVER_HOST="sqlserver" # localhost
SQL_SERVER_PORT="1433" # 5174
SQL_SERVER_USER="sa"
SQL_SERVER_PASSWORD="password123!"

# Guard rails for the shared server
QUERY_TIMEOUT_MS="10000"
QUERY_MAX_ROWS="500"
QUERY_MAX_LENGTH="5000"
