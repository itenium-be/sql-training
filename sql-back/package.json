{
  "name": "sql-back",
  "version": "1.0.0",
  "author": "itenium",
  "license": "MIT",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts | pino-pretty",
    "build": "tsup",
    "start": "bun dist/index.js",
    "clean": "rimraf dist coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --fix",
    "format": "biome format src/",
    "test": "vitest run --passWithNoTests",
    "verify-solutions": "bun src/scripts/verifySolutions.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "envalid": "^9.0.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "mssql": "^12.7.14",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "tsup": {
    "entry": [
      "src",
      "!src/**/__tests__/**",
      "!src/**/*.test.*"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  }
}
